# Copy this file to "backend/.env" and paste your Gemini API key.
# (If you leave it out, the backend falls back to GEMINI_API_KEY in frontend/.env.)
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional
PORT=8000
ENABLE_LLM_VERIFIER=true
ENABLE_AUDIT_LOG=true
RATE_LIMIT_PER_MINUTE=20
# Comma-separated list of website origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
